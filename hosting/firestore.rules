rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A player's own save. Nobody else can read or touch it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A friend duel. Both players read and write the same document.
    match /duels/{code} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Who is online, and nothing else: a heartbeat, a name and an avatar.
    // Readable by anyone signed in so a friend can see the green dot; only
    // ever writable by the person it describes. Deliberately a separate
    // collection from /users so opening presence up does not open a player's
    // whole save with it.
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
