{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/*.apk"],
    "rewrites": [
      {
        "source": "/c/**",
        "destination": "/c.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      }
    ]
  }
}
